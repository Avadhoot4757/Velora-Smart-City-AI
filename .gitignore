# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config
# Uncomment if team members need individual Firebase projects
# .firebaserc

# Firebase service account keys
backend/functions/serviceAccountKey.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
node_modules/
frontend/web/node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables
.env
frontend/web/.env.*

# Next.js build and cache
frontend/web/.next/
frontend/web/.next/trace
frontend/web/.next/static/webpack/*.hot-update.*

# Python cache
backend/functions/**/__pycache__/
*.pyc

# Node.js lock files (choose one based on package manager)
